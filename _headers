/*
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Logo files keep their names when their contents change, so a long cache serves a
# retired mark to anyone who fetched the old one. It happened: the RTMC pack served
# the superseded wordmark for hours after the mark was replaced. Revalidate instead.
# These files are small and this site's traffic is tiny; correctness is worth more
# than the bandwidth. Use a versioned filename if a long cache is ever needed.
/assets/logos/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/assets/downloads/*
  Cache-Control: public, max-age=0, must-revalidate

# The stylesheet and the fonts are published for other sites to link directly, so
# they need the same permissive CORS as /ai. Both are regenerated on every release
# and keep their names, so they revalidate rather than sitting in a long cache.
/assets/brand.css
  Access-Control-Allow-Origin: *
  Content-Type: text/css; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

/assets/brand.tokens.css
  Access-Control-Allow-Origin: *
  Content-Type: text/css; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

/assets/fonts/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

